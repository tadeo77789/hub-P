# Copy to .env and fill in. Never commit real values.
# Local model in Ollama (install Ollama, then: ollama pull qwen3:4b-instruct)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT=60
# How long the model stays loaded in the GPU after the last request
OLLAMA_KEEP_ALIVE=30m
# Long-term memory: embedding model in Ollama (ollama pull qwen3-embedding:0.6b).
# Facts are stored in %LOCALAPPDATA%\PaulaPort\memory.sqlite3. "off" disables it.
MEMORY_EMBED_MODEL=qwen3-embedding:0.6b

RABBITMQ_URL=amqp://paula:paula@localhost:5672/
# Shared secret used to authenticate every message between hub and pc-agent (32+ chars)
AGENT_SHARED_SECRET=

# Alexa notifications (Lambda Function URL, see alexa-skill/README.md). Empty = log only.
ALEXA_NOTIFY_URL=
# Separate secret shared only with the Lambda (32+ chars, never AGENT_SHARED_SECRET)
ALEXA_NOTIFY_SECRET=
# Actions that take at least this long also send an Alexa alert
LONG_TASK_SECONDS=30

LOG_LEVEL=INFO
